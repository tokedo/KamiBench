---
import Base from '../../layouts/Base.astro';
// Posts derive from ../blog/*.md in the repo root at build time — see lib/blog.ts.
import { getPosts } from '../../lib/blog';

const posts = getPosts();
---

<Base
  title="Blog — KamiBench"
  description="Research posts from KamiBench — arguments and results from testing agent continual learning in a persistent world with a verifiable history."
  path="/blog"
>
  <header class="hero container">
    <h1>Blog</h1>
    <p class="hero-tagline">
      Notes on the research as the experiments progress: what we are testing,
      what the runs show, and why it matters. Designs and results live on the
      experiment cards in the{' '}
      <a href="/experiments">registry</a>{' '}— posts comment on them but never
      replace them. Claims in posts are labeled:{' '}
      <span class="chip chip-ok">REGISTERED</span>{' '}when they trace to a
      registered run,{' '}
      <span class="chip chip-pending">EXPLORATORY</span>{' '}otherwise.
    </p>
  </header>

  <section class="section container" aria-label="Posts">
    <ul class="cards exp-list">
      {
        posts.map((post) => (
          <li class="card exp-card">
            <p class="label">{post.dateLabel}</p>
            <h2>
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p>{post.oneliner}</p>
          </li>
        ))
      }
    </ul>
    <p class="read-more"><a href="/rss.xml">RSS feed →</a></p>
  </section>
</Base>
