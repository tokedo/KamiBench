---
import '../styles/global.css';
// The footer disclosure renders from README.md's DISCLOSURE markers at build
// time — see lib/readme.ts.
import { readmeSection } from '../lib/readme';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, used for the canonical URL, e.g. "/paper". */
  path?: string;
  /** OpenGraph type; the paper page is an article. */
  ogType?: 'website' | 'article';
}

const { title, description, path = '/', ogType = 'website' } = Astro.props;
const canonical = new URL(path, Astro.site);
// Versioned filename: scrapers (Discord, Twitter, Slack) cache og images by URL,
// so a content change must also change the URL to show up in new shares.
const ogImage = new URL('/og-v2.png', Astro.site);
const github = 'https://github.com/tokedo/KamiBench';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131110" />
    <meta property="og:site_name" content="KamiBench" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="KamiBench — testing agent continual learning in a persistent world with a verifiable history"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@0xTokedo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      /* Google Analytics (GA4) — production builds only, so dev-server visits
         don't pollute the data. is:inline keeps Astro from bundling the tags. */
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-G0HWCTPZF7"
          ></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-G0HWCTPZF7');
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        {
          /* Brand mark (public/mark.svg), inlined so the stroke can follow
             currentColor — it has to invert with the light/dark theme, which an
             <img> can't do. Geometry is verbatim; the viewBox is cropped to the
             ink (x 4→82.7, y 4.3→61.5 of the 88×66 original) so the height set
             in CSS measures the glyph itself, with no transparent padding. */
        }
        <a class="wordmark" href="/">
          <svg
            class="wordmark-mark"
            viewBox="4 4.27 78.73 57.23"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 55 H38 V17 H64"
              fill="none"
              stroke="currentColor"
              stroke-width="13"
              stroke-linecap="butt"
              stroke-linejoin="miter"></path>
            <rect
              x="-9"
              y="-9"
              width="18"
              height="18"
              transform="translate(70 17) rotate(45)"
              fill="#E08D6D"></rect>
          </svg>
          <span>KamiBench</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a
            href="/experiments"
            aria-current={path.startsWith('/experiments') ? 'page' : undefined}>Experiments</a
          >
          <a href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/stack" aria-current={path === '/stack' ? 'page' : undefined}>Stack</a>
          <a href={github} class="nav-github" aria-label="GitHub" title="GitHub">
            {/* GitHub mark, inline so it follows currentColor with the theme. */}
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <h2>Disclosure</h2>
        <Fragment set:html={readmeSection('DISCLOSURE')} />
        <div class="footer-meta">
          <span><a href={`${github}/blob/main/LICENSE`}>MIT License</a></span>
          <span><a href={github}>GitHub</a></span>
          <span><a href="https://x.com/0xTokedo">@0xTokedo</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
